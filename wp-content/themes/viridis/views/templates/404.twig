{% extends 'layouts/base.twig' %}

{% block content %}
	<div class="bg-gray-100 py-12 lg:py-16">
		<div class="w-full mx-auto xl:container px-6">
			<h1 class="text-3xl lg:text-4xl text-gray-700 uppercase font-semibold font-sans">Page Not Found</h1>
		</div>
	</div>

	<div class="w-full mx-auto xl:container px-6 py-12 lg:py-24">
		<div class="max-w-2xl mx-auto text-center">
			<div class="text-8xl font-black text-gray-200 mb-8">404</div>
			<p class="text-xl text-gray-600 mb-8">Sorry, we couldn't find the page you're looking for.</p>
			<a href="{{ site.url }}" class="button button--primary">Return Home</a>
		</div>
	</div>
{% endblock %}
