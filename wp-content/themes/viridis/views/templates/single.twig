{% extends 'layouts/base.twig' %}

{% block content %}
	<article class="post-type-{{ post.type }}" id="post-{{ post.id }}">
		{# Post Header #}
		<div class="bg-gray-100 py-12 lg:py-16">
			<div class="w-full mx-auto xl:container px-6">
				<h1 class="text-3xl lg:text-4xl text-gray-700 font-semibold font-sans entry-title">{{ post.title }}</h1>

				<div class="mt-4 flex items-center gap-4 text-gray-500">
					<time datetime="{{ post.date|date('Y-m-d') }}" class="font-semibold">
						{{ post.date|date('F j, Y') }}
					</time>

					{% if post.author %}
						<span>&bull;</span>
						<span>By <a href="{{ post.author.path }}" class="text-green hover:underline">{{ post.author.name }}</a></span>
					{% endif %}
				</div>
			</div>
		</div>

		{# Featured Image #}
		{% if post.thumbnail %}
			<div class="w-full mx-auto xl:container px-6 -mt-8">
				<img
					src="{{ post.thumbnail.src }}"
					alt="{{ post.thumbnail.alt }}"
					class="w-full max-h-96 object-cover rounded-xl shadow-lg"
				/>
			</div>
		{% endif %}

		{# Post Content #}
		<div class="w-full mx-auto xl:container px-6 py-12 lg:py-16">
			<div class="prose prose-lg max-w-none">
				{{ post.content }}
			</div>
		</div>

		{# Categories/Tags #}
		{% if post.terms('category') %}
			<div class="w-full mx-auto xl:container px-6 pb-12">
				<div class="flex flex-wrap gap-2">
					{% for category in post.terms('category') %}
						<a href="{{ category.link }}" class="bg-gray-100 text-gray-700 px-3 py-1 rounded-full text-sm font-semibold hover:bg-green hover:text-white transition-colors">
							{{ category.name }}
						</a>
					{% endfor %}
				</div>
			</div>
		{% endif %}
	</article>
{% endblock %}
