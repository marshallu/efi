{% if preheading %}
	<div class="viridis-block__preheading font-black text-lg lg:text-xl leading-none mt-1">{{ preheading }}</div>
{% endif %}

{% if heading %}
	<div class="viridis-block__heading text-3xl lg:text-2xl xl:text-4xl text-hard-shadow-10" role="heading" aria-level="2">{{ heading }}</div>
{% endif %}

{% if subheading %}
	<div class="viridis-block__subheading text-lg font-semibold max-w-3xl mx-auto mt-6">{{ subheading }}</div>
{% endif %}
