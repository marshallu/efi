{#
/**
 * Call To Action Block
 *
 * @package viridis
 */
#}

{% set background = fields.background_color|default('green') %}
{% set block_class = 'viridis-block--' ~ background %}

<div class="viridis-block {{ block_class }} viridis-call-to-action-block">
	<div class="w-full mx-auto xl:container px-6 py-12">
		<div class="grid grid-cols-1 lg:grid-cols-3 gap-8 lg:gap-16">
			<div class="lg:col-span-2">
				{% if fields.heading %}
					<h2 class="viridis-block__heading text-left text-3xl lg:text-6xl font-black uppercase text-shadow">{{ fields.heading }}</h2>
				{% endif %}
			</div>

			<div class="">
				{% if fields.links %}
					{% for link in fields.links %}
						<a href="{{ link.link_url }}" class="viridis-block__links group flex gap-4 items-start px-4 py-3 no-underline relative transition-all duration-100 ease-in-out">
							<svg class="h-5 w-5 transition-all duration-100 ease-in-out mt-1 opacity-60 group-hover:opacity-100 group-hover:translate-x-1" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="currentColor"><path fill-rule="evenodd" d="M3.75 12a.75.75 0 01.75-.75h13.19l-5.47-5.47a.75.75 0 011.06-1.06l6.75 6.75a.75.75 0 010 1.06l-6.75 6.75a.75.75 0 11-1.06-1.06l5.47-5.47H4.5a.75.75 0 01-.75-.75z" clip-rule="evenodd" /></svg>
							<div class="uppercase text-xl font-bold flex-1 pr-1 transition-all duration-100 ease-in-out group-hover:underline">{{ link.link_title }}</div>
						</a>
					{% endfor %}
				{% endif %}
			</div>
		</div>
	</div>
</div>
