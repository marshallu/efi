<a
	href="{{ post.link }}"
	class="group rounded-xl bg-white shadow-sm hover:shadow-lg transition-all ease-linear duration-150 flex flex-col h-full hover:scale-[1.01]"
>
	{% if post.thumbnail %}
		<div class="w-full aspect-4/3">
			<img
				src="{{ post.thumbnail.src }}"
				alt="{{ post.thumbnail.alt ?: post.title }}"
				class="aspect-4/3 w-full object-cover object-center rounded-t-xl"
			/>
		</div>
	{% else %}
		<div class="w-full aspect-4/3 bg-gray-200 rounded-t-xl flex items-center justify-center">
			<svg class="w-16 h-16 text-gray-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
				<path stroke-linecap="round" stroke-linejoin="round" stroke-width="1" d="M4 16l4.586-4.586a2 2 0 012.828 0L16 16m-2-2l1.586-1.586a2 2 0 012.828 0L20 14m-6-6h.01M6 20h12a2 2 0 002-2V6a2 2 0 00-2-2H6a2 2 0 00-2 2v12a2 2 0 002 2z"></path>
			</svg>
		</div>
	{% endif %}

	<div class="flex-1 px-6 py-4 transition-all ease-linear duration-150 rounded-b-xl">
		<h2 class="font-black text-xl text-green transition-all ease-linear duration-150 group-hover:text-green-bright">
			{{ post.title }}
		</h2>

		<time
			datetime="{{ post.date|date('Y-m-d') }}"
			class="block text-sm text-gray-500 mt-4 font-semibold"
		>
			{{ post.date|date('F j, Y') }}
		</time>
	</div>
</a>
